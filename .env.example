# ---- Server ----
PORT=4021
NODE_ENV=development

# ---- x402 / USDC payments (via CDP SDK) ----
# createX402Server provisions a resource server wired to the CDP hosted
# facilitator — get these from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Wallet address that RECEIVES payments. If set, the server settles
# directly into this fixed address (payToConfig: { type: "address" })
# and CDP_WALLET_SECRET below is NOT required.
X402_PAY_TO_ADDRESS=0xYourWalletAddressHere

# Only needed if you leave X402_PAY_TO_ADDRESS blank and want the server
# to provision + manage its own CDP-hosted receiving wallet instead.
CDP_WALLET_SECRET=

# "development" = Base Sepolia + Solana Devnet (default here, use while
# building). "production" = Base mainnet + Solana mainnet.
#
# ⚠️  DO NOT set this to "production" in your LOCAL .env. Production
# settings (real wallet, real Postgres, real CDP key) belong only in
# your deployment's environment (e.g. deploy/akash/deploy.local.yaml),
# never on a dev machine — this file should always stay "development".
CDP_X402_SERVER_ENVIRONMENT=development

# ---- Pricing (USDC, decimal strings) ----
PRICE_QUERY=0.01
PRICE_STORAGE_UPLOAD=0.05
PRICE_STORAGE_DOWNLOAD=0.01
PRICE_AD_IMPRESSION=0.001
PRICE_AGENT_REGISTER=0.00

# ---- Database ----
# Postgres connection string. Matches docker-compose's postgres service
# out of the box; if running Postgres locally (not via docker-compose),
# point this at your own instance instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_agent_hub

# ---- MCP ----
MCP_TRANSPORT=http
MCP_PATH=/mcp

# ---- Frontend ----
FRONTEND_PORT=3000
BACKEND_PUBLIC_URL=http://localhost:4021
